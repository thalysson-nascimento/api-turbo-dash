# PostgreSQL persistente para a Vercel. Não use SQLite em produção.
PRISMA_DATABASE_URL="postgresql://user:password@host:5432/turbo_dash?sslmode=require"
# Alternativas reconhecidas: POSTGRES_URL ou DATABASE_URL.
# Para SQLite local, use somente DATABASE_URL="file:./dev.db".
# Somente para navegador/WebGL; apps nativos não precisam de CORS.
ALLOWED_ORIGINS="http://localhost:3000"
